{
  "manifest_version": 3,
  "name": "DSA Companion",
  "version": "1.0.0",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://www.hackerrank.com/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.hackerrank.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}